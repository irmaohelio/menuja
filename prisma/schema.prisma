generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USUARIOS (DONOS DE LOJA) ====================
model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  password    String
  role        String   @default("merchant")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store?
  sessions Session[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== LOJA ====================
model Store {
  id            String   @id @default(uuid())
  userId        String   @unique
  slug          String   @unique
  name          String
  description   String?
  logo          String?
  banner        String?
  phone         String?
  whatsapp      String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  segment       String   @default("outros")
  isOpen        Boolean  @default(false)
  isTempClosed  Boolean  @default(false)
  tempClosedMsg String?
  isActive      Boolean  @default(true)
  primaryColor  String   @default("#e11d48")
  secondaryColor String  @default("#f0abfc")
  buttonColor   String   @default("#e11d48")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings       StoreSettings?
  categories     Category[]
  products       Product[]
  customers      Customer[]
  orders         Order[]
  businessHours  BusinessHour[]
  highlights     StoreHighlight[]
  notifications  Notification[]
  pizzaCrusts    PizzaCrust[]
}

model StoreSettings {
  id               String  @id @default(uuid())
  storeId          String  @unique
  deliveryEnabled  Boolean @default(true)
  pickupEnabled    Boolean @default(true)
  deliveryFee      Float   @default(0)
  minOrder         Float   @default(0)
  avgPrepTime      Int     @default(30)
  acceptOrders     Boolean @default(true)
  cashEnabled      Boolean @default(true)
  pixEnabled       Boolean @default(false)
  cardEnabled      Boolean @default(false)
  pixKey           String?
  halfAndHalfRule  String  @default("highest")
  halfAndHalfPrice Float?
  whatsappOrders   Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model BusinessHour {
  id         String  @id @default(uuid())
  storeId    String
  dayOfWeek  Int
  isOpen     Boolean @default(true)
  openTime   String?
  closeTime  String?
  openTime2  String?
  closeTime2 String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
}

// ==================== CATEGORIAS ====================
model Category {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  description String?
  image       String?
  type        String   @default("standard")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
}

// ==================== PRODUTOS ====================
model Product {
  id            String   @id @default(uuid())
  storeId       String
  categoryId    String?
  name          String
  description   String?
  image         String?
  price         Float
  promoPrice    Float?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  isPizza       Boolean  @default(false)
  sizesBackup   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  optionGroups ProductOptionGroup[]
  pizzaSizes   PizzaSize[]
  orderItems   OrderItem[]

  @@index([storeId])
  @@index([categoryId])
}

model ProductOptionGroup {
  id        String  @id @default(uuid())
  productId String
  storeId   String
  name      String
  required  Boolean @default(false)
  minQty    Int     @default(0)
  maxQty    Int     @default(1)
  sortOrder Int     @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])
}

model ProductOption {
  id        String  @id @default(uuid())
  groupId   String
  name      String
  price     Float   @default(0)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ==================== PIZZA ====================
model PizzaSize {
  id        String   @id @default(uuid())
  productId String
  name      String
  price     Float
  slices    Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavors   PizzaFlavor[]

  @@index([productId])
}

model PizzaFlavor {
  id        String @id @default(uuid())
  sizeId    String
  name      String
  price     Float  @default(0)
  sortOrder Int    @default(0)

  size PizzaSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
}

model PizzaCrust {
  id        String  @id @default(uuid())
  storeId   String
  name      String
  price     Float   @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ==================== CLIENTES ====================
model Customer {
  id        String   @id @default(uuid())
  storeId   String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  addresses CustomerAddress[]

  @@index([storeId])
}

model CustomerAddress {
  id           String  @id @default(uuid())
  customerId   String
  address      String
  number       String?
  complement   String?
  neighborhood String?
  reference    String?
  isDefault    Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ==================== PEDIDOS ====================
model Order {
  id                   String   @id @default(uuid())
  storeId              String
  customerId           String?
  orderNumber          Int
  customerName         String
  customerPhone        String?
  customerAddress      String?
  customerNumber       String?
  customerComplement   String?
  customerNeighborhood String?
  customerReference    String?
  deliveryType         String   @default("delivery")
  paymentMethod        String   @default("cash")
  changeFor            Float?
  subtotal             Float
  deliveryFee          Float    @default(0)
  discount             Float    @default(0)
  total                Float
  status               String   @default("received")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  statusLog OrderStatusLog[]

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  notes       String?
  sizeName    String?
  crustName   String?
  halfHalf    Boolean @default(false)
  flavor1     String?
  flavor2     String?

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  options OrderItemOption[]

  @@index([orderId])
}

model OrderItemOption {
  id          String @id @default(uuid())
  orderItemId String
  name        String
  price       Float  @default(0)
  quantity    Int    @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model OrderStatusLog {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ==================== PAGAMENTOS ====================
model Payment {
  id        String   @id @default(uuid())
  orderId   String
  method    String
  amount    Float
  status    String   @default("pending")
  changeFor Float?
  createdAt DateTime @default(now())
}

// ==================== DESTAQUES ====================
model StoreHighlight {
  id        String  @id @default(uuid())
  storeId   String
  type      String
  productId String?
  label     String?
  sortOrder Int     @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ==================== NOTIFICACOES ====================
model Notification {
  id        String   @id @default(uuid())
  storeId   String
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  orderId   String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}
